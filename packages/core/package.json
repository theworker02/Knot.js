{
    "name":  "@magnexis/knot.js-core",
    "version":  "0.3.0",
    "description":  "Content-addressed dependency resolution, storage, and execution for Knot.js",
    "license":  "SEE LICENSE IN LICENSE",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20.10.0"
                },
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          },
                    "./loader":  {
                                     "types":  "./dist/runtime/loader.d.ts",
                                     "import":  "./dist/runtime/loader.js"
                                 }
                },
    "files":  [
                  "dist",
                  "LICENSE",
                  "README.md"
              ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/theworker02/Knot.js.git",
                       "directory":  "packages/core"
                   },
    "homepage":  "https://github.com/theworker02/Knot.js",
    "bugs":  {
                 "url":  "https://github.com/theworker02/Knot.js/issues"
             },
    "keywords":  [
                     "knot",
                     "content-addressed",
                     "dependencies",
                     "javascript",
                     "typescript",
                     "runtime"
                 ],
    "scripts":  {
                    "build":  "tsc -p tsconfig.json \u0026\u0026 node scripts/copy-preload.mjs",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})\"",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "node -e \"process.exit(0)\""
                },
    "dependencies":  {
                         "semver":  "^7.6.3",
                         "smol-toml":  "^1.3.1",
                         "tar":  "^7.4.3",
                         "yaml":  "^2.7.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^26.6.2"
                        }
}
